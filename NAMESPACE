# 手写，不由 roxygen 生成。
#
# 理由：roxygen 8.1.1 在本机处理到 NAMESPACE 这一步会段错误（man/ 下的
# .Rd 已经由它正常产出）。导出清单本身很稳定，手写反而更可控——尤其是
# 几个非标准名字（"$"、"["、"[<-"、"%*%"）必须写对引号。
#
# 注意：R/mat.R 里的 @export 标记保留着，作为「这个函数要导出」的说明；
# 若日后 roxygen 修好，直接 roxygenise() 会以那些标记为准重建本文件，
# 结果应与下面一致。

useDynLib(ROpenEigen, .registration = TRUE)

importFrom(Rcpp, evalCpp)

# median / quantile 在 stats 里，不在 base。要给它们注册 S3 方法，泛型本身
# 必须在本命名空间里可见，否则加载时直接报 "object 'median' not found"。
importFrom(stats, median)
importFrom(stats, quantile)

# ---------------------------------------------------------------- 构造与类型
export(eigenMat)
export(eigenVec)
export(is_eigen)

# ---------------------------------------------------------------- 生成器
export(eigen_identity)
export(eigen_zeros)
